# ============================================================
# StreamX - STAGING Environment Configuration
# ============================================================

ENVIRONMENT=staging
APP_NAME=StreamX Staging
APP_VERSION=1.0.0+1

# API Configuration
BASE_URL=https://api-staging.streamx.app/api/v1
API_KEY=${STAGING_API_KEY}
API_TIMEOUT=30000

# Firebase Configuration (Staging Project)
FIREBASE_PROJECT_ID=streamx-staging
FIREBASE_APP_ID_ANDROID=${STAGING_FIREBASE_APP_ID_ANDROID}
FIREBASE_APP_ID_IOS=${STAGING_FIREBASE_APP_ID_IOS}
FIREBASE_APP_ID_WEB=${STAGING_FIREBASE_APP_ID_WEB}
FCM_SENDER_ID=${STAGING_FCM_SENDER_ID}
FIREBASE_API_KEY=${STAGING_FIREBASE_API_KEY}
FIREBASE_STORAGE_BUCKET=streamx-staging.appspot.com
FIREBASE_AUTH_DOMAIN=streamx-staging.firebaseapp.com
FIREBASE_DATABASE_URL=https://streamx-staging-default-rtdb.firebaseio.com

# Video Configuration
VIDEO_CDN_BASE_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample
VIDEO_BUFFER_SIZE_MB=15
VIDEO_MAX_CACHE_SIZE_MB=1000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_REMOTE_CONFIG=true
ENABLE_CERTIFICATE_PINNING=true
ENABLE_SCREENSHOT_PREVENTION=false

# Auth Configuration
TOKEN_REFRESH_THRESHOLD_MINUTES=5
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

# Logging
LOG_LEVEL=debug
ENABLE_HTTP_LOGGING=true
