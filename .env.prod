# ============================================================
# StreamX - PRODUCTION Environment Configuration
# ============================================================
# CRITICAL: All values must be injected from GitHub Secrets / 
# CI/CD environment variables. NEVER hardcode secrets here.

ENVIRONMENT=production
APP_NAME=StreamX
APP_VERSION=1.0.0+1

# API Configuration
BASE_URL=https://api.streamx.app/api/v1
API_KEY=${PROD_API_KEY}
API_TIMEOUT=20000

# Firebase Configuration (Production Project)
FIREBASE_PROJECT_ID=${PROD_FIREBASE_PROJECT_ID}
FIREBASE_APP_ID_ANDROID=${PROD_FIREBASE_APP_ID_ANDROID}
FIREBASE_APP_ID_IOS=${PROD_FIREBASE_APP_ID_IOS}
FIREBASE_APP_ID_WEB=${PROD_FIREBASE_APP_ID_WEB}
FCM_SENDER_ID=${PROD_FCM_SENDER_ID}
FIREBASE_API_KEY=${PROD_FIREBASE_API_KEY}
FIREBASE_STORAGE_BUCKET=${PROD_FIREBASE_STORAGE_BUCKET}
FIREBASE_AUTH_DOMAIN=${PROD_FIREBASE_AUTH_DOMAIN}
FIREBASE_DATABASE_URL=${PROD_FIREBASE_DATABASE_URL}
FIREBASE_MESSAGING_SENDER_ID=${PROD_FCM_SENDER_ID}

# Video Configuration
VIDEO_CDN_BASE_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample
VIDEO_BUFFER_SIZE_MB=20
VIDEO_MAX_CACHE_SIZE_MB=2000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_REMOTE_CONFIG=true
ENABLE_CERTIFICATE_PINNING=true
ENABLE_SCREENSHOT_PREVENTION=true

# Auth Configuration
TOKEN_REFRESH_THRESHOLD_MINUTES=5
SESSION_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=3

# Logging
LOG_LEVEL=error
ENABLE_HTTP_LOGGING=false

# Security
SSL_CERTIFICATE_PIN=${PROD_SSL_CERT_PIN}
SSL_CERTIFICATE_PIN_BACKUP=${PROD_SSL_CERT_PIN_BACKUP}
