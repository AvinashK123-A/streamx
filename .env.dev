# ============================================================
# StreamX - DEVELOPMENT Environment Configuration
# ============================================================
# WARNING: Never commit real secrets to version control
# Use GitHub Secrets / CI/CD env vars for production

ENVIRONMENT=development
APP_NAME=StreamX Dev
APP_VERSION=1.0.0+1

# API Configuration
BASE_URL=http://10.0.2.2:8080/api/v1
API_KEY=dev_api_key_replace_me
API_TIMEOUT=30000

# Firebase Configuration (Development Project)
FIREBASE_PROJECT_ID=streamx-dev
FIREBASE_APP_ID_ANDROID=1:000000000000:android:dev_app_id
FIREBASE_APP_ID_IOS=1:000000000000:ios:dev_app_id
FIREBASE_APP_ID_WEB=1:000000000000:web:dev_app_id
FCM_SENDER_ID=000000000000
FIREBASE_API_KEY=dev_firebase_api_key
FIREBASE_STORAGE_BUCKET=streamx-dev.appspot.com
FIREBASE_AUTH_DOMAIN=streamx-dev.firebaseapp.com
FIREBASE_DATABASE_URL=https://streamx-dev-default-rtdb.firebaseio.com

# Video Configuration
VIDEO_CDN_BASE_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample
VIDEO_BUFFER_SIZE_MB=10
VIDEO_MAX_CACHE_SIZE_MB=500

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASHLYTICS=false
ENABLE_PERFORMANCE_MONITORING=false
ENABLE_REMOTE_CONFIG=false
ENABLE_CERTIFICATE_PINNING=false
ENABLE_SCREENSHOT_PREVENTION=false

# Auth Configuration
TOKEN_REFRESH_THRESHOLD_MINUTES=5
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5

# Logging
LOG_LEVEL=verbose
ENABLE_HTTP_LOGGING=true
